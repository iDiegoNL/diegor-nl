---
import { Picture } from 'astro:assets';
import avatar from '../assets/avatar.jpeg';

const links = [
  ['#experience', 'Experience'],
  ['#fansapi', 'FansAPI'],
  ['#awoostria', 'Awoostria'],
  ['#archive', 'Archive'],
];
---

<header>
  <a class="me" href="#top">
    <Picture src={avatar} formats={['avif']} fallbackFormat="webp" width={72} height={72} alt="" loading="eager" />
    Diego Relyveld
  </a>
  <nav aria-label="Sections">
    {links.map(([href, label]) => <a href={href}>{label}</a>)}
  </nav>
  <a class="cta" href="mailto:me@diegor.nl">Get in touch</a>
</header>

<style>
  header {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 20px 0;
  }
  .me {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: 18px;
    font-weight: 700;
  }
  img {
    width: 36px;
    height: 36px;
    border-radius: 50%;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    gap: 4px;
    padding: 4px;
    border-radius: 24px;
    background: var(--card);
    box-shadow: 0 0 0 1px var(--line), 0 6px 16px -8px rgb(23 21 28 / 0.12);
    font-size: 15px;
    font-weight: 500;
  }
  nav a {
    padding: 7px clamp(9px, 2.5vw, 14px);
    border-radius: var(--pill);
  }
  nav a:hover {
    background: var(--hover);
  }
  .cta {
    padding: 10px 18px;
    border-radius: var(--pill);
    background: var(--ink);
    color: #fff;
    font-size: 15px;
    font-weight: 600;
  }
  .cta:hover {
    background: var(--violet);
    color: #fff;
  }
  /* Narrow screens: name + CTA share the first row, nav drops below. */
  @media (max-width: 719px) {
    nav {
      order: 1;
    }
  }
</style>
