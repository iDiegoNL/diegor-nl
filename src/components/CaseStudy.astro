---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import type { FeatureGroup, Project, Stat } from '../data/content';

interface Props {
  id: string;
  tone: 'violet' | 'rose';
  logo: ImageMetadata;
  title: string;
  kicker: string;
  sub: string;
  link?: { href: string; label: string };
  stats: Stat[];
  ownedTitle: string;
  owned: Project[];
  features: FeatureGroup[];
  stack: string[];
}

const { id, tone, logo, title, kicker, sub, link, stats, ownedTitle, owned, features, stack } = Astro.props;
// Rose (Awoostria) pads its transparent logo onto white, so the image itself is 60px at 1x.
const logoSize = tone === 'rose' ? 120 : 144;
const meta = `${owned.length} projects · ${features.length} feature areas · ${stack.length} technologies`;
---

<section id={id} class={tone}>
  <div class="head">
    <Picture src={logo} formats={['avif']} fallbackFormat="webp" width={logoSize} height={logoSize} alt="" />
    <div>
      <p class="kicker">{kicker}</p>
      <h2>{title}</h2>
      <p class="sub">
        {sub}
        {link && <a class="ext" href={link.href}>{link.label}</a>}
      </p>
    </div>
  </div>

  <dl class="stats">
    {
      stats.map(([value, label]) => (
        <div>
          <dt>{label}</dt>
          <dd>{value}</dd>
        </div>
      ))
    }
  </dl>

  <h3>{ownedTitle}</h3>
  <div class="preview">
    <ul class="chips">{owned.map((p) => <li>{p.name}</li>)}</ul>
    <p class="also"><strong>Also worked on:</strong> {features.map((g) => g.title).join(' · ')}</p>
  </div>

  {/* Native disclosure: works without JS and opens on find-in-page. */}
  <details>
    <summary><span class="btn dn">Show full case study</span><span class="meta">{meta}</span></summary>
    <div class="grid">
      {
        owned.map((p) => (
          <article>
            <h4>{p.name}</h4>
            <p>{p.description}</p>
          </article>
        ))
      }
    </div>
    <h3>Features I worked on</h3>
    <div class="grid">
      {
        features.map((g) => (
          <div class="group">
            <h4>{g.title}</h4>
            <ul class="checks">{g.items.map((item) => <li>{item}</li>)}</ul>
          </div>
        ))
      }
    </div>
    <h3>Tech stack</h3>
    <ul class="chips stack">{stack.map((s) => <li>{s}</li>)}</ul>
    <button type="button" class="collapse up">Collapse</button>
  </details>
</section>

<style>
  section {
    --a: var(--violet);
    --a-ink: var(--violet-ink);
    --a-hover: var(--violet-hover);
    --a-soft: var(--violet-soft);
    --a-line: var(--violet-line);
    --a-shadow: rgb(74 42 153 / 0.5);
    margin-bottom: clamp(40px, 6vw, 72px);
    padding: clamp(24px, 4vw, 56px);
    border-radius: var(--r-panel);
    background: var(--a-soft);
  }
  .rose {
    --a: var(--rose);
    --a-ink: var(--rose);
    --a-hover: var(--rose-hover);
    --a-soft: var(--rose-soft);
    --a-line: var(--rose-line);
    --a-shadow: rgb(163 32 58 / 0.45);
    margin-bottom: var(--section);
  }
  .head {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .head img {
    flex: none;
    width: 72px;
    height: 72px;
    border-radius: 18px;
    box-shadow: 0 12px 24px -12px var(--a-shadow);
  }
  .rose .head img {
    padding: 6px;
    background: var(--card);
    object-fit: contain;
  }
  .kicker {
    color: var(--a-ink);
    font-size: 14px;
    font-weight: 600;
  }
  h2 {
    margin-top: 4px;
    font-size: clamp(40px, 5.5vw, 68px);
    font-weight: 800;
    letter-spacing: -0.04em;
    line-height: 1;
  }
  .sub {
    margin-top: 6px;
    color: var(--muted);
    font-size: 15px;
  }
  .sub a {
    color: var(--a);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .stats {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 180px), 1fr));
    gap: 12px;
    margin-top: 32px;
  }
  /* Label first in the DOM so it reads "label: value"; the number still shows on top. */
  .stats div {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 8px;
    padding: 18px 20px;
    border-radius: var(--r-card);
    background: var(--card);
  }
  dt {
    color: var(--muted);
    font-size: 14px;
  }
  dd {
    color: var(--a);
    font-size: 36px;
    font-weight: 800;
    letter-spacing: -0.03em;
    line-height: 1;
  }
  h3 {
    margin: 48px 0 16px;
    font-size: 22px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
  }
  .chips li {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding: 9px 16px;
    border-radius: var(--pill);
    background: var(--card);
    font-size: 15px;
    font-weight: 600;
  }
  .chips li::before {
    content: '';
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--a);
  }
  .stack {
    margin-top: 12px;
  }
  .stack li {
    padding: 7px 14px;
    font-size: 14px;
    font-weight: 500;
  }
  .stack li::before {
    content: none;
  }
  .also {
    max-width: 820px;
    margin-top: 20px;
    color: var(--body);
    font-size: 15px;
    line-height: 1.6;
  }
  .also strong {
    color: var(--ink);
  }
  summary {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 10px;
    margin-top: 24px;
    list-style: none;
    cursor: pointer;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline: none;
  }
  .btn,
  .collapse {
    padding: 13px 24px;
    border: 0;
    border-radius: var(--pill);
    background: var(--a);
    color: #fff;
    font: 600 16px var(--sans);
  }
  summary:hover .btn {
    background: var(--a-hover);
  }
  summary:focus-visible .btn {
    outline: 2px solid var(--a);
    outline-offset: 3px;
  }
  .meta {
    color: var(--muted);
    font-size: 14px;
  }
  /* Open: the chip preview and the expand button give way to the full write-up. */
  section:has(details[open]) .preview,
  details[open] summary {
    display: none;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 12px;
    margin-top: 12px;
  }
  article {
    padding: 20px 22px 22px;
    border-radius: var(--r-card);
    background: var(--card);
  }
  h4 {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.01em;
  }
  article p {
    margin-top: 8px;
    color: var(--body);
    font-size: 15px;
    line-height: 1.55;
    text-wrap: pretty;
  }
  .group {
    padding: 20px 22px;
    border-radius: var(--r-card);
    background: rgb(255 255 255 / 0.6);
    box-shadow: inset 0 0 0 1px var(--a-line);
  }
  .group h4 {
    margin-bottom: 12px;
    font-size: 16px;
  }
  .checks {
    display: flex;
    flex-direction: column;
    gap: 7px;
  }
  .checks li {
    display: grid;
    grid-template-columns: 18px 1fr;
    color: var(--ink-3);
    font-size: 15px;
    line-height: 1.45;
  }
  .checks li::before {
    content: '✓';
    content: '✓' / '';
    color: var(--a);
    font-weight: 700;
  }
  .collapse {
    display: block;
    margin: 32px auto 0;
    padding: 11px 20px;
    background: var(--card);
    color: var(--ink);
    font-size: 15px;
    cursor: pointer;
  }
</style>
