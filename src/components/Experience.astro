---
import type { ImageMetadata } from 'astro';
import { Picture } from 'astro:assets';
import awoostria from '../assets/awoostria.png';
import fans from '../assets/fans-holding.png';
import { resume } from '../data/content';

// Same transform options as the case-study headers, so each logo is one shared file.
const logos: Record<string, { src: ImageMetadata; size: number }> = {
  'Fans Holdings': { src: fans, size: 144 },
  Awoostria: { src: awoostria, size: 120 },
};
// The other employers render as a monogram tile instead of an extra image request.
const monogram = (name: string) => (name.match(/\b[A-Z]/g) ?? []).join('').slice(0, 3);
---

<section id="experience">
  <h2 class="h2">Experience</h2>
  <ul>
    {
      resume.map((job) => {
        const logo = logos[job.company];
        return (
          <li>
            {logo ? (
              <Picture
                src={logo.src}
                formats={['avif']}
                fallbackFormat="webp"
                width={logo.size}
                height={logo.size}
                alt=""
              />
            ) : (
              <span class="mark" aria-hidden="true">
                {monogram(job.company)}
              </span>
            )}
            <div>
              <strong>{job.company}</strong>
              <span>{job.title}</span>
              <span class="when">
                {job.start} – {job.end}
              </span>
            </div>
            {job.anchor && (
              <a href={job.anchor} aria-label={`${job.company} case study`}>
                Case study
              </a>
            )}
          </li>
        );
      })
    }
  </ul>
</section>

<style>
  section {
    padding-bottom: var(--section);
  }
  h2 {
    margin-bottom: 24px;
  }
  ul {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 340px), 1fr));
    gap: 12px;
  }
  li {
    display: flex;
    align-items: center;
    gap: 16px;
    padding: 16px 18px;
    border-radius: var(--r-card);
    background: var(--card);
    box-shadow: 0 0 0 1px var(--line);
  }
  img,
  .mark {
    flex: none;
    width: 48px;
    height: 48px;
    padding: 4px;
    border-radius: 12px;
    background: var(--card);
    box-shadow: 0 0 0 1px var(--line);
    object-fit: contain;
  }
  .mark {
    display: grid;
    place-items: center;
    background: var(--hover);
    color: var(--muted);
    font-size: 14px;
    font-weight: 700;
    letter-spacing: -0.02em;
  }
  div {
    flex: 1;
    min-width: 0;
    color: var(--muted);
    font-size: 14px;
  }
  strong,
  span {
    display: block;
  }
  strong {
    color: var(--ink);
    font-size: 17px;
  }
  .when {
    margin-top: 4px;
    color: var(--faint);
    font-family: var(--mono);
    font-size: 12px;
  }
  a {
    flex: none;
    padding: 6px 12px;
    border-radius: var(--pill);
    background: var(--violet-soft);
    color: var(--violet-ink);
    font-size: 13px;
    font-weight: 600;
  }
</style>
